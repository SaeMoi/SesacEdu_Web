<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee" version="6.0">
<display-name>새싹에듀 React 메인 + JSP</display-name>
<servlet><servlet-name>login</servlet-name><jsp-file>/WEB-INF/views/login.jsp</jsp-file></servlet>
<servlet-mapping><servlet-name>login</servlet-name><url-pattern>/login</url-pattern></servlet-mapping>
<servlet><servlet-name>signup</servlet-name><jsp-file>/WEB-INF/views/signup.jsp</jsp-file></servlet>
<servlet-mapping><servlet-name>signup</servlet-name><url-pattern>/signup</url-pattern></servlet-mapping>
<servlet><servlet-name>courses</servlet-name><jsp-file>/WEB-INF/views/courses.jsp</jsp-file></servlet>
<servlet-mapping><servlet-name>courses</servlet-name><url-pattern>/courses</url-pattern></servlet-mapping>
<servlet><servlet-name>detail</servlet-name><jsp-file>/WEB-INF/views/detail.jsp</jsp-file></servlet>
<servlet-mapping><servlet-name>detail</servlet-name><url-pattern>/courses/detail</url-pattern></servlet-mapping>
<!-- 강의 학습 화면: JSP 내부에서 /lectures/숫자/learn 형식을 확인합니다. -->
<servlet><servlet-name>lecture</servlet-name><jsp-file>/WEB-INF/views/lecture.jsp</jsp-file></servlet>
<servlet-mapping><servlet-name>lecture</servlet-name><url-pattern>/lectures/*</url-pattern></servlet-mapping>
<servlet><servlet-name>review-popup</servlet-name><jsp-file>/WEB-INF/views/review-popup.jsp</jsp-file></servlet>
<servlet-mapping><servlet-name>review-popup</servlet-name><url-pattern>/courses/reviews</url-pattern></servlet-mapping>
<servlet><servlet-name>chatbot</servlet-name><jsp-file>/WEB-INF/views/chatbot.jsp</jsp-file></servlet>
<servlet-mapping><servlet-name>chatbot</servlet-name><url-pattern>/chatbot</url-pattern></servlet-mapping>
<servlet><servlet-name>community</servlet-name><jsp-file>/WEB-INF/views/community.jsp</jsp-file></servlet>
<servlet-mapping><servlet-name>community</servlet-name><url-pattern>/community</url-pattern></servlet-mapping>
<servlet><servlet-name>post-detail</servlet-name><jsp-file>/WEB-INF/views/post-detail.jsp</jsp-file></servlet>
<servlet-mapping><servlet-name>post-detail</servlet-name><url-pattern>/community/detail</url-pattern></servlet-mapping>
<servlet><servlet-name>post-write</servlet-name><jsp-file>/WEB-INF/views/post-write.jsp</jsp-file></servlet>
<servlet-mapping><servlet-name>post-write</servlet-name><url-pattern>/community/write</url-pattern></servlet-mapping>
<servlet><servlet-name>post-done</servlet-name><jsp-file>/WEB-INF/views/post-done.jsp</jsp-file></servlet>
<servlet-mapping><servlet-name>post-done</servlet-name><url-pattern>/community/done</url-pattern></servlet-mapping>
<!-- 과제는 JSP로 렌더링하고 공통 헤더는 React로 마운트합니다. -->
<servlet><servlet-name>assignments</servlet-name><jsp-file>/WEB-INF/views/assignments.jsp</jsp-file></servlet>
<servlet-mapping><servlet-name>assignments</servlet-name><url-pattern>/assignments</url-pattern></servlet-mapping>
<servlet><servlet-name>preview</servlet-name><jsp-file>/WEB-INF/views/preview.jsp</jsp-file></servlet>
<servlet-mapping><servlet-name>preview</servlet-name><url-pattern>/courses/preview</url-pattern></servlet-mapping>
<welcome-file-list><welcome-file>index.html</welcome-file></welcome-file-list></web-app>